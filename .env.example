# Copy to .env and fill in. Never commit real values.

# Database (Neon Postgres)
DATABASE_URL=

# Auth (Better Auth) — secret must be at least 32 characters
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: Facebook login is enabled only when both are set
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Stream (video + chat)
NEXT_PUBLIC_STREAM_VIDEO_API_KEY=
STREAM_VIDEO_SECRET_KEY=
NEXT_PUBLIC_STREAM_CHAT_API_KEY=
STREAM_CHAT_SECRET_KEY=
# Minutes to wait after the last person leaves before ending the call (default 2)
EMPTY_ROOM_TIMEOUT_MIN=2

# AI
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
# Kill switch for the realtime voice agent (true/false, default true)
AI_VOICE_ENABLED=true

# Payments (Polar) — "sandbox" or "production"
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox

# Email (Resend). When both are set, email/password users must verify their
# email. When missing, links are printed to the dev server console instead.
RESEND_API_KEY=
EMAIL_FROM="Meet.AI <noreply@your-domain.com>"

# Inngest (production only; set automatically by the Vercel integration)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
